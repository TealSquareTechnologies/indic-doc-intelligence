# Consciousnx credentials. Copy this file to .env and fill in a real key.
CONSCIOUSNX_API_KEY=your-consciousnx-api-key-here
CONSCIOUSNX_BASE_URL=https://backend.consciousnx.com/raw/v1
CONSCIOUSNX_MODEL=cx-medium

# Seconds to wait for one model response. Default is 20 minutes.
LLM_TIMEOUT_SECONDS=1200
# A retry repeats the whole wait above.
LLM_MAX_RETRIES=0

# HTTP server
HOST=127.0.0.1
PORT=8000

# Absolute path to the Tesseract binary. Leave blank to use the system PATH.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Language data directory. Relative paths are inside the project.
TESSDATA_DIR=tessdata

# SQLite database location, relative to the repository root unless absolute.
DATABASE_PATH=data/app.db

# Languages used when a request does not specify any.
DEFAULT_OCR_LANGUAGES=eng+kan+tam+tel

# Retrieval settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=250
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=3
SIMILARITY_THRESHOLD=0.20

# Maximum accepted upload size in bytes (25 MB).
MAX_UPLOAD_BYTES=26214400

# Resolution used for scanned PDF pages.
PDF_RENDER_DPI=200
# Most pages read from one PDF.
MAX_PDF_PAGES=50

# Optional shared secret. When set, every /api request must send X-API-Key.
API_KEY=
